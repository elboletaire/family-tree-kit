# Copy to .env and fill in
DOMAIN=arbre.example.com
SITE_PASSWORD=change-me
# 0 (the default): the whole site closed, only its login page without the password. 1: the public version (without
# the living) to everybody, the rest with the password. After changing it: docker compose up -d web
PUBLIC_SITE=0
# Optional
SESSION_DAYS=30
# Optional: a random text; changing it (or the password) closes every session
# SESSION_SECRET=
# Optional: the sources folder (`paths.sources` in families.yml; by default `sources`). The post-receive hook
# reads it from families.yml; set it here to run `docker compose up` by hand.
# SOURCES_DIR=sources
# Optional: user that generates build/ (by default 1000:1000)
# ARBRE_UID=1000
# ARBRE_GID=1000
